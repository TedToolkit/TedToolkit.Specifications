    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageVersion Include="Npgsql" Version="9.0.2" />
    <PackageVersion Include="TedToolkit.RoslynHelper" Version="2026.9.9" />
    <PackageVersion Include="TedToolkit.Localizations" Version="2026.7.7" />
    <PackageVersion Include="TUnit" Version="1.35.2" />
  </ItemGroup>
</Project>
