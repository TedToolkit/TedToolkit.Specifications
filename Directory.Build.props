<Project>
  <Import Project="$(MSBuildThisFileDirectory)externals/TedToolkit/props/CodeAnalysis.props" />
  <ItemGroup>
    <PackageReference Include="SonarAnalyzer.CSharp" PrivateAssets="all" />
  </ItemGroup>
  <PropertyGroup>
    <RepositoryRoot>$(MSBuildThisFileDirectory)</RepositoryRoot>
    <LangVersion>14.0</LangVersion>
    <Version>0.1.0</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RepositoryUrl>https://github.com/TedToolkit/TedToolkit.Specifications</RepositoryUrl>
    <PackageProjectUrl>https://github.com/TedToolkit/TedToolkit.Specifications</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>LGPL-3.0-only</PackageLicenseExpression>
  </PropertyGroup>
</Project>
