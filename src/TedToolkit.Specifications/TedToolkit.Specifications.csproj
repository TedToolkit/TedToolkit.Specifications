<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(RepositoryRoot)externals/TedToolkit/props/NugetPackage.props" />
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <IsAotCompatible>true</IsAotCompatible>
    <Description>Composable business specifications with generated typed member selections and compile-time diagnostics.</Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TedToolkit.Specifications.Sql" />
    <None Include="../TedToolkit.Specifications.Analyzers/bin/$(Configuration)/netstandard2.0/TedToolkit.Specifications.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="../TedToolkit.Specifications.Analyzers/bin/$(Configuration)/netstandard2.0/TedToolkit.RoslynHelper.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="../TedToolkit.Specifications.Analyzers/bin/$(Configuration)/netstandard2.0/TedToolkit.Localizations.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="../TedToolkit.Specifications.Analyzers/bin/$(Configuration)/netstandard2.0/ZString.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="../TedToolkit.Specifications.Analyzers/bin/$(Configuration)/netstandard2.0/System.Memory.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>
</Project>
